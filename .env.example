# =============================================================
# KLIK - variabel environment (salin ke .env, JANGAN commit .env)
# =============================================================
# Diambil dari: Supabase Dashboard -> Project Settings -> API
# Hanya URL + anon (publishable) key yang boleh masuk frontend.
# SERVICE ROLE KEY TIDAK BOLEH pernah ada di file ini atau di kode frontend.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Dipakai HANYA oleh Supabase Edge Functions (bukan frontend).
# Tidak perlu ada di .env web sama sekali; di Edge Function simpan sebagai secret:
#   supabase secrets set AUTH_PEPPER=...
AUTH_PEPPER=CHANGE_ME_SERVER_SIDE_ONLY
